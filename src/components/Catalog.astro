---
import { Image } from "astro:assets";
import catalogPreview from "../assets/catalog-preview.png";

const catalogs = [
    {
        title: "Catálogo Master",
        description:
            "Líneas completas de Rodamientos, Bandas, Cadenas y Transmisión de Potencia.",
        techId: "SPEC-TRT-MASTER",
        lines: "+20",
        rev: "2026",
        pdf: "/CATALOGO_MASTER.pdf",
    },
    {
        title: "Catálogo W-MAX",
        description:
            "Especializado en componentes de transmisión de potencia de alta resistencia.",
        techId: "SPEC-TRT-WMAX",
        lines: "+15",
        rev: "2026",
        pdf: "/CATALOGO-W-MAX.pdf",
    },
    {
        title: "Catálogo C-FAG",
        description:
            "Soluciones técnicas en rodamientos y componentes de precisión.",
        techId: "SPEC-TRT-CFAG",
        lines: "+12",
        rev: "2026",
        pdf: "/C-FAG.pdf",
    },
    {
        title: "Catálogo Placas 2026",
        description:
            "Línea completa de placas y accesorios para transmisión mecánica.",
        techId: "SPEC-TRT-PLACAS",
        lines: "+10",
        rev: "2026",
        pdf: "/PLACAS%202026.pdf",
    },
    {
        title: "Catálogo CC MAX",
        description: "Cangilones para elevadores de banda CC MAX",
        techId: "SPEC-TRT-CCMAX",
        lines: "1",
        rev: "2026",
        pdf: "/cc-max_POLY_compressed.pdf",
    },
];
---

<section class="content-section catalog-section" id="catalogos">
    <div class="section-shell relative-content">
        <p class="section-kicker">INGENIERÍA EN MOVIMIENTO</p>
        <h2>Catálogos por Línea</h2>
        <p class="section-description">
            Explora nuestras soluciones técnicas de alta precisión. Descarga la
            ficha técnica o solicita una cotización inmediata.
        </p>

        <div class="catalog-grid">
            {
                catalogs.map((cat) => (
                    <article class="catalog-card-outer double-bezel-outer-light">
                        <div class="catalog-card-inner double-bezel-inner-light">
                            <div class="catalog-visual">
                                <Image
                                    src={catalogPreview}
                                    alt={`Vista previa del ${cat.title}`}
                                    class="catalog-img"
                                />
                                <div class="catalog-overlay">
                                    <span class="tech-id">{cat.techId}</span>
                                </div>
                            </div>
                            <div class="catalog-details">
                                <div class="catalog-content">
                                    <div class="catalog-header">
                                        <h3>{cat.title}</h3>
                                    </div>
                                    <p>{cat.description}</p>
                                    <div class="catalog-specs">
                                        <div class="spec-item">
                                            <span class="spec-label">
                                                LÍNEAS
                                            </span>
                                            <span class="spec-value">
                                                {cat.lines}
                                            </span>
                                        </div>
                                        <div class="spec-item">
                                            <span class="spec-label">REV</span>
                                            <span class="spec-value">
                                                {cat.rev}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="catalog-footer">
                                    <a
                                        href={cat.pdf}
                                        download
                                        class="btn--pdf-full"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            width="18"
                                            height="18"
                                            aria-hidden="true"
                                        >
                                            <>
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                                                <polyline points="7 10 12 15 17 10" />
                                                <line
                                                    x1="12"
                                                    y1="15"
                                                    x2="12"
                                                    y2="3"
                                                />
                                            </>
                                        </svg>
                                        Descargar Ficha PDF
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* NEW: Catalog Section Styles */
    .catalog-section {
        background: #f5f4f1 !important;
        border-top: none !important;
        border-bottom: 1px solid #e5e7eb;
        padding: var(--section-padding) 0;
    }

    .catalog-section .section-kicker {
        color: var(--color-accent-primary);
    }

    .catalog-section h2 {
        font-size: clamp(2rem, 4vw, 2.8rem);
        margin-bottom: 20px;
        letter-spacing: -0.02em;
        color: var(--color-brand-primary);
    }

    .catalog-section .section-description {
        color: rgba(15, 23, 42, 0.85);
        margin-bottom: 56px;
        font-size: 1.15rem;
        font-weight: 500;
        max-width: 55ch;
        text-align: left;
        margin-left: 0;
    }

    .catalog-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 28px;
        max-width: 960px;
        margin: 0 auto;
    }

    .catalog-card-inner {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .btn--pdf-full {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        width: 100%;
        padding: 14px;
        background: var(--color-brand-primary);
        color: white;
        text-decoration: none;
        font-weight: 700;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .btn--pdf-full:hover {
        background: var(--color-brand-accent);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(234, 88, 12, 0.2);
    }

    .double-bezel-outer-light:hover {
        border-color: var(--color-action-primary-default);
        transform: translateY(-5px);
        box-shadow: 0 16px 30px rgba(29, 49, 129, 0.12);
    }

    .double-bezel-outer-light:hover .double-bezel-inner-light {
        background: #ffffff;
    }

    .catalog-visual {
        position: relative;
        background: transparent;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
    }

    .catalog-img {
        width: 100%;
        height: auto; /* La imagen dicta su propia altura y proporción */
        display: block;
        border-radius: 4px 8px 8px 4px; /* Pequeño borde para que parezca libro */
        transition: transform 0.6s var(--motion-easing-default);
        filter: drop-shadow(
            0 15px 25px rgba(0, 0, 0, 0.15)
        ); /* Sombra realista */
    }

    .double-bezel-outer-light:hover .catalog-img {
        transform: scale(1.04) translateY(-4px); /* Se levanta un poco al hover */
        filter: drop-shadow(0 20px 35px rgba(0, 0, 0, 0.2));
    }

    .catalog-details {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 16px 0;
    }

    .catalog-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: flex-end;
        justify-content: flex-start; /* Alinear etiqueta a la izquierda */
        padding: 16px;
        pointer-events: none; /* Que no bloquee clicks */
    }

    .tech-id {
        font-family: "Courier New", Courier, monospace;
        font-size: 0.75rem;
        font-weight: 700;
        color: #ffffff;
        background: rgba(0, 0, 0, 0.6);
        padding: 4px 8px;
        border-radius: 4px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        letter-spacing: 0.1em;
    }

    .catalog-content {
        padding: 24px 32px;
        flex-grow: 1;
    }

    .catalog-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 12px;
    }

    .catalog-header h3 {
        font-size: 1.25rem;
        color: var(--color-brand-primary);
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .catalog-badge {
        font-size: 0.6rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 4px 8px;
        background: rgba(15, 23, 42, 0.05);
        color: var(--color-brand-primary);
        border-radius: 4px;
        border: 1px solid rgba(15, 23, 42, 0.1);
    }

    .catalog-content p {
        font-size: 0.9rem;
        color: rgba(15, 23, 42, 0.65);
        line-height: 1.6;
        margin-bottom: 24px;
    }

    .catalog-specs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        border-top: 1px solid rgba(15, 23, 42, 0.08);
        padding-top: 20px;
    }

    .spec-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .spec-label {
        font-size: 0.65rem;
        font-weight: 800;
        color: rgba(15, 23, 42, 0.4);
        text-transform: uppercase;
        letter-spacing: 0.1em;
    }

    .spec-value {
        font-size: 0.95rem;
        font-weight: 700;
        color: var(--color-brand-accent);
    }

    .catalog-footer {
        padding: 0 32px 24px;
        display: flex; /* Cambiado a flex ya que solo hay un botón */
    }

    @media (max-width: 768px) {
        .catalog-grid {
            grid-template-columns: 1fr;
        }

        .catalog-visual {
            flex: auto;
            min-height: auto;
            height: auto;
        }

        .catalog-content {
            padding: 24px;
        }

        .catalog-footer {
            padding: 0 24px 24px;
        }
    }
</style>
